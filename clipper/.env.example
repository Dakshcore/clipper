# Copy to clipper/.env (git-ignored) or set these in your shell.
# Never put real values in code, config.yaml or logs.

# Only needed when llm_backend is "claude" in config.yaml.
# The default backend is "local" (Ollama on this machine) and needs no key.
# If the chosen backend is not available the clipper falls back to a text
# heuristic and says so in the log.
ANTHROPIC_API_KEY=

# Only needed when llm_backend is "venice". Create the key at venice.ai under
# Settings > API. Paste it as issued: one line, no quotes, no "Bearer" prefix.
VENICE_API_KEY=

# Only needed when discover_category is set in config.yaml.
# Twitch: register an app at dev.twitch.tv/console/apps.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick: create an app at kick.com under Settings > Developer.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
